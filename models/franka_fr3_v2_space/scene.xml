<mujoco model="fr3v2 free floating scene">
  <include file="fr3v2.xml"/>

  <!-- Microgravity setup for space robotics simulation -->
  <option timestep="0.002" gravity="0 0 0"/>

  <statistic center="0.35 0 0.65" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.02 0.03 0.07 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.02 0.03 0.08" rgb2="0 0 0" width="512" height="3072"/>

    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.08 0.10 0.13"
             rgb2="0.02 0.03 0.05"
             markrgb="0.3 0.3 0.3"
             width="300"
             height="300"/>

    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.05"/>

    <material name="target_red" rgba="1 0.05 0.05 1"/>
    <material name="target_green" rgba="0.1 1 0.2 1"/>
  </asset>

  <worldbody>
    <!-- Visual reference plane only. It has no contact, no collision. -->
    <geom name="visual_floor"
          size="0 0 0.05"
          type="plane"
          material="groundplane"
          contype="0"
          conaffinity="0"/>

    <light name="main_light"
           pos="0 0 2.5"
           dir="0 0 -1"
           directional="true"/>

    <light name="side_light"
           pos="1 -1 1.5"
           dir="-1 1 -1"
           directional="true"/>

    <!-- Target for ReAct-NS reaching task -->
    <body name="target_body" pos="0.65 0.25 0.75">
      <geom name="target_marker"
            type="sphere"
            size="0.045"
            material="target_red"
            contype="0"
            conaffinity="0"/>

      <site name="target_site"
            pos="0 0 0"
            size="0.05"
            rgba="1 0 0 1"/>
    </body>

    <!-- Optional reference marker for initial base position -->
    <body name="base_reference_marker" pos="0 0 0.6">
      <geom name="base_reference_sphere"
            type="sphere"
            size="0.015"
            material="target_green"
            contype="0"
            conaffinity="0"/>
    </body>

    <camera name="demo_camera"
            pos="1.5 -1.5 1.1"
            xyaxes="0.707 0.707 0 -0.35 0.35 0.866"/>
  </worldbody>
</mujoco>